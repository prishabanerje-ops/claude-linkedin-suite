# LinkedIn API credentials for the post-linkedin skill family.
# ---------------------------------------------------------------------------
# 1. Copy this file to:  ~/.config/linkedin-api.env
# 2. Fill in your real values below.
# 3. NEVER commit the filled-in file — it holds a secret token.
#    (The installer copies this template for you if the file doesn't exist.)
#
# Format: KEY=value, one per line. '#' starts a comment. No quotes needed.
#
# Where to get these:
#   LINKEDIN_ACCESS_TOKEN
#     An OAuth 2.0 member access token with the `w_member_social` scope.
#     LinkedIn Developer app → Products (Share on LinkedIn / Sign In with
#     LinkedIn) → Auth → generate/authorize a member token.
#   LINKEDIN_PERSON_ID
#     Your person URN id — the part AFTER "urn:li:person:". Fetch it from the
#     OpenID userinfo endpoint (the "sub" field), e.g.:
#       curl -H "Authorization: Bearer $LINKEDIN_ACCESS_TOKEN" \
#            https://api.linkedin.com/v2/userinfo
# ---------------------------------------------------------------------------

LINKEDIN_ACCESS_TOKEN=your_access_token_here
LINKEDIN_PERSON_ID=your_person_id_here
